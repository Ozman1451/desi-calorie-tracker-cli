# ─────────────────────────────────────────────────────────────────
# Desi Calorie Tracker v1 — Environment Variables
# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────

# Supabase project credentials
# Found at: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Gemini API key
# Found at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Fixed user ID for v1 (no auth — single test user)
DEFAULT_USER_ID=v1_test_user

# Gemini model to use for both transcription (Call A) and parsing (Call B/C)
GEMINI_MODEL=gemini-3.6-flash

# Optional: path for latency log file (defaults to "latency.log" in project root)
LATENCY_LOG_PATH=latency.log
